# ─────────────────────────────────────────────
#  Blush & Balloons — Environment Variables
#  Copy this file to .env and fill in your values
#  NEVER commit your real .env to Git
# ─────────────────────────────────────────────

# Server
PORT=8080

# Gmail SMTP (for booking notification emails)
# Step 1: Enable 2-Factor Auth on your Gmail account
# Step 2: Go to Google Account → Security → App Passwords → Generate
# Step 3: Paste the 16-character app password below (NOT your Gmail login password)
EMAIL_USER=ballonsblush@gmail.com
EMAIL_PASS=World@0717

# Where booking notification emails should be sent (usually your business email)
OWNER_EMAIL=blushandballoons@gmail.com

# CORS — set to your domain in production, e.g. https://blushandballoons.com
ALLOWED_ORIGIN=https://blushandballons.roboshope.shop

# Admin key for GET /api/bookings (change this to something secret!)
ADMIN_KEY=July@0717
